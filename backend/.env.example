# Captionline transcription service - environment configuration.
#
# Copy to `.env` for local development:
#   cp .env.example .env
#
# Every environment variable the service reads is documented below: all 59 read
# by `app/config.py` plus SUPPORT_EMAIL, which `app/terms.py` reads. Nothing is
# read that is not listed here, and nothing here is read unless the service uses
# it, so this file is the complete list.
#
# Each entry states its safe default, whether it is a secret, and what it does.
# The defaults shown are the ones built into the code, so an empty file behaves
# exactly like this one.
#
# NEVER commit a real `.env` file. Four variables are secrets:
#   DATABASE_URL, EMAIL_API_KEY, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET
# All four are empty here. WhisperX models are public, so transcription itself
# needs no secret at all.

# ============================================================================
# 1. DEPLOYMENT ENVIRONMENT - READ THIS FIRST
# ============================================================================
#
# APP_ENV  (default: development)  [not a secret]
# Which deployment this is. Recognised values: production, development, test.
# Anything other than "production" is treated as development, so a typo cannot
# silently disable the production checks below.
#
# >>> PRODUCTION MUST SET THIS TO `production`. <<<
#
# The whole production safety gate is switched off unless this is exactly
# "production". With APP_ENV unset, or set to anything else, the service starts
# happily with a configuration that is unsafe in production and the problem is
# never reported. When it IS "production", startup refuses to serve at all - it
# raises before binding any traffic - if any of the following is true:
#
#   * CORS_ORIGINS contains "*" (list the exact frontend origin instead)
#   * EMAIL_PROVIDER is "console" or "memory", which print password reset
#     links, and their raw tokens, to the log
#   * DATABASE_ECHO is on, which logs every SQL statement including bind
#     parameters such as password hashes and token hashes
#   * FRONTEND_URL is empty, is not an https:// origin, or points at
#     localhost / 127.0.0.1, so reset and checkout links would be wrong or
#     would travel in clear text
#   * STRIPE_SECRET_KEY is set while FRONTEND_URL is not https, so Stripe's
#     success and cancel redirects would land on a clear-text origin
#   * EMAIL_PROVIDER=resend with no EMAIL_API_KEY, so no password reset mail
#     can be sent
#
# This is a deliberate breaking change for a misconfigured production: the first
# deploy that sets APP_ENV=production will refuse to boot until the problems
# above are fixed. That is the point - the fault is found at startup rather than
# during an incident.
APP_ENV=development

# ============================================================================
# 2. DATABASE
# ============================================================================
# DATABASE_URL  (default: unset)  [SECRET]
# PostgreSQL connection string. Leave unset to run transcription-only: the
# service still starts and transcribes, /api/health reports
# database.status = "not_configured", and the account endpoints return 503.
# Production (Railway): DATABASE_URL=${{Postgres.DATABASE_URL}}
# Local PostgreSQL: postgresql://captionline:<password>@localhost:5432/captionline
# Local without PostgreSQL (development and tests only, NOT production):
#   sqlite:///./captionline.db
# `postgres://` and `postgresql://` are both accepted and normalised to
# postgresql+psycopg:// automatically.
DATABASE_URL=

# DATABASE_ECHO  (default: 0)  [not a secret]
# Log every SQL statement. Never enable in production: statements can contain
# values derived from user input, including password and token hashes. Setting
# this in production is refused at startup.
DATABASE_ECHO=0

# ============================================================================
# 3. SERVER
# ============================================================================
# HOST  (default: 0.0.0.0)  [not a secret]
# Bind address. 0.0.0.0 is required on a container platform such as Railway.
HOST=0.0.0.0

# PORT  (default: 8000)  [not a secret]
# TCP port. Railway supplies PORT; 8000 is the local default.
PORT=8000

# CORS_ORIGINS  (default: the local Vite dev and preview origins)  [not a secret]
# Comma-separated list of browser origins allowed to call the API. A "*" entry
# allows any origin, is allowed with credentials turned off, and is refused at
# startup when APP_ENV=production. List the exact origin in production, e.g.
#   CORS_ORIGINS=https://captionline.pro
# Use "*" only for initial testing.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# ============================================================================
# 4. TRANSPORT AND RESPONSE HARDENING
# ============================================================================
# TRUST_PROXY_HEADERS  (default: 0 / false)  [not a secret]
# Whether X-Forwarded-For may be used to derive a rate-limit bucket key. Leave
# off unless a proxy that OVERWRITES that header is known to sit in front of the
# service: the header is otherwise client-controlled, and trusting it lets one
# caller mint unlimited rate-limit buckets and defeats the limits entirely. Set
# to 1 only when a trusted proxy is in front.
TRUST_PROXY_HEADERS=0

# HSTS_ENABLED  (default: unset)  [not a secret]
# Force Strict-Transport-Security on or off. Unset (recommended) means "decide
# per request": the header is sent only over an HTTPS request, so a local
# plain-HTTP run can never be pinned to HTTPS by a cached header. Set to 1 if
# TLS terminates upstream and the app cannot see the https scheme; set to 0 to
# suppress it entirely.
# HSTS_ENABLED=

# ============================================================================
# 5. RATE LIMITING
# ============================================================================
# Every limit below is a fixed window and is applied both per client address and
# per account, so rotating addresses does not defeat a limit and one account
# cannot be sprayed from many hosts. A limit or a window of 0 disables that
# bucket. Throttled requests get 429 with a generic message and a Retry-After
# header, except forgot-password, which keeps answering 200 so that throttling
# is not observable.
#
# RATE_LIMIT_MAX_KEYS  (default: 10000)  [not a secret]
# Hard ceiling on how many in-process counters are held at once, so memory is
# bounded no matter how many keys an attacker supplies. The oldest unused entry
# is evicted first. Raising this raises the memory ceiling with it.
RATE_LIMIT_MAX_KEYS=10000

# RATE_LIMIT_REGISTER  (default: 5)  [not a secret]
# Account creations per window, per address and per email address.
RATE_LIMIT_REGISTER=5
# RATE_LIMIT_REGISTER_WINDOW_SECONDS  (default: 3600)  [not a secret]
# Window for RATE_LIMIT_REGISTER.
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600

# RATE_LIMIT_LOGIN  (default: 10)  [not a secret]
# Sign-in attempts per window, per address and per account. Argon2id is
# deliberately expensive, so this is the main defence against a distributed
# password-guessing or CPU-exhaustion attack.
RATE_LIMIT_LOGIN=10
# RATE_LIMIT_LOGIN_WINDOW_SECONDS  (default: 300)  [not a secret]
# Window for RATE_LIMIT_LOGIN.
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300

# RATE_LIMIT_TRANSCRIBE  (default: 20)  [not a secret]
# Transcription requests per window, per address and per account.
RATE_LIMIT_TRANSCRIBE=20
# RATE_LIMIT_TRANSCRIBE_WINDOW_SECONDS  (default: 300)  [not a secret]
# Window for RATE_LIMIT_TRANSCRIBE.
RATE_LIMIT_TRANSCRIBE_WINDOW_SECONDS=300

# RATE_LIMIT_CHECKOUT  (default: 10)  [not a secret]
# Stripe Checkout session creations per window. Also caps the damage from a
# script that opens many sessions.
RATE_LIMIT_CHECKOUT=10
# RATE_LIMIT_CHECKOUT_WINDOW_SECONDS  (default: 3600)  [not a secret]
# Window for RATE_LIMIT_CHECKOUT.
RATE_LIMIT_CHECKOUT_WINDOW_SECONDS=3600

# RATE_LIMIT_PORTAL  (default: 10)  [not a secret]
# Stripe Customer Portal sessions per window, per address and per account.
RATE_LIMIT_PORTAL=10
# RATE_LIMIT_PORTAL_WINDOW_SECONDS  (default: 3600)  [not a secret]
# Window for RATE_LIMIT_PORTAL.
RATE_LIMIT_PORTAL_WINDOW_SECONDS=3600

# RATE_LIMIT_CHANGE_PASSWORD  (default: 5)  [not a secret]
# Password changes per window. A successful change signs every session out.
RATE_LIMIT_CHANGE_PASSWORD=5
# RATE_LIMIT_CHANGE_PASSWORD_WINDOW_SECONDS  (default: 900)  [not a secret]
# Window for RATE_LIMIT_CHANGE_PASSWORD.
RATE_LIMIT_CHANGE_PASSWORD_WINDOW_SECONDS=900

# RATE_LIMIT_RESET_PASSWORD  (default: 10)  [not a secret]
# Reset token redemptions per window, per address and per account.
RATE_LIMIT_RESET_PASSWORD=10
# RATE_LIMIT_RESET_PASSWORD_WINDOW_SECONDS  (default: 900)  [not a secret]
# Window for RATE_LIMIT_RESET_PASSWORD.
RATE_LIMIT_RESET_PASSWORD_WINDOW_SECONDS=900

# RATE_LIMIT_DELETE_ACCOUNT  (default: 5)  [not a secret]
# Account deletion attempts per window. It has its own bucket rather than
# sharing one with password changes, so a user who mistypes a new password five
# times can still close their account.
RATE_LIMIT_DELETE_ACCOUNT=5
# RATE_LIMIT_DELETE_ACCOUNT_WINDOW_SECONDS  (default: 900)  [not a secret]
# Window for RATE_LIMIT_DELETE_ACCOUNT.
RATE_LIMIT_DELETE_ACCOUNT_WINDOW_SECONDS=900

# RATE_LIMIT_DURABLE_ENABLED  (default: 1 / true)  [not a secret]
# Keep a shared, database-backed counter for the three unauthenticated buckets
# (register, login, forgot-password). The in-process counters above are per
# replica: on a host running N replicas an attacker who reaches all of them
# gets N times the limit, every counter resets when a replica is recycled, and a
# rolling deploy resets the whole fleet's budget. Those properties are tolerable
# for transcription and billing, where the caller is signed in, and not
# tolerable where password guessing and free-tier account minting begin. The
# in-process pre-filter still runs first and in front of this, so a flood is
# absorbed before it reaches the database. If the database is unreachable the
# durable check allows the request and logs, because a limiter that turns a
# database blip into a 500 on the login page converts a degraded dependency into
# an outage. Set to 0 to keep only the cheap per-replica layer. Requires
# DATABASE_URL; without it this half is inactive and the in-process layer is the
# whole control.
RATE_LIMIT_DURABLE_ENABLED=1

# RATE_LIMIT_DURABLE_PRUNE_INTERVAL_SECONDS  (default: 300)  [not a secret]
# How often, at most, a request that is already writing the shared table
# opportunistically deletes rows whose window has expired. The retention horizon
# is derived from the longest bucket window above, not configured separately,
# so the two can never disagree and leave a row behind forever. There is no
# scheduler and no background thread.
RATE_LIMIT_DURABLE_PRUNE_INTERVAL_SECONDS=300

# ============================================================================
# 6. ACCOUNTS AND SESSIONS
# ============================================================================
# SESSION_TTL_DAYS  (default: 30)  [not a secret]
# Lifetime of an issued bearer session, in days. Expired and revoked rows are
# also purged opportunistically in the background.
SESSION_TTL_DAYS=30

# MIN_PASSWORD_LENGTH  (default: 8)  [not a secret]
# Minimum accepted password length at registration and on a password change.
MIN_PASSWORD_LENGTH=8

# SESSION_CLEANUP_INTERVAL_SECONDS  (default: 900)  [not a secret]
# How often expired/revoked session rows are purged opportunistically.
SESSION_CLEANUP_INTERVAL_SECONDS=900

# ============================================================================
# 7. PASSWORD RESET
# ============================================================================
# PASSWORD_RESET_TTL_MINUTES  (default: 60)  [not a secret]
# How long an emailed reset link stays usable.
PASSWORD_RESET_TTL_MINUTES=60

# PASSWORD_RESET_COOLDOWN_SECONDS  (default: 60)  [not a secret]
# Per-account abuse control: a new request within this window of the last one is
# ignored, while the generic response is still returned. This is the durable
# half of the reset protection; it needs no rate-limit configuration.
PASSWORD_RESET_COOLDOWN_SECONDS=60

# PASSWORD_RESET_MAX_ACTIVE  (default: 3)  [not a secret]
# Issuing a new token once this many are outstanding revokes the older ones, so
# an old emailed link stops working.
PASSWORD_RESET_MAX_ACTIVE=3

# PASSWORD_RESET_IP_LIMIT  (default: 5)  [not a secret]
# Per-client-address throttle on the forgot-password endpoint, applied before any
# database work. It is the "forgot-password" rate-limit bucket, so it shares
# the in-process and durable layers described in section 5. The name is kept for
# compatibility with existing deployments.
PASSWORD_RESET_IP_LIMIT=5

# PASSWORD_RESET_IP_WINDOW_SECONDS  (default: 900)  [not a secret]
# Window for PASSWORD_RESET_IP_LIMIT.
PASSWORD_RESET_IP_WINDOW_SECONDS=900

# ============================================================================
# 8. TRANSACTIONAL EMAIL
# ============================================================================
# Password reset emails only. No other transactional mail exists yet.
#
# EMAIL_PROVIDER  (default: none)  [not a secret]
# Which email provider to use:
#   resend          production. Requires EMAIL_API_KEY.
#   console         local development only; writes the message body, including
#                   the raw reset token, to the log. Refused at startup when
#                   APP_ENV=production.
#   memory          tests only. Refused at startup when APP_ENV=production.
#   unset / other   no provider: password reset still answers with the generic
#                   response, but no email is delivered and a warning is logged
#                   at boot outside production.
# "console" and "memory" never activate unless named explicitly, so a production
# deployment cannot print reset links to the log stream.
EMAIL_PROVIDER=none

# EMAIL_API_KEY  (default: unset)  [SECRET]
# Resend API key. Server side only; the frontend never sees it. Obtain from the
# Resend dashboard -> API Keys. Required when EMAIL_PROVIDER=resend, and a
# missing key with that provider is refused at startup in production.
EMAIL_API_KEY=

# EMAIL_FROM  (default: Captionline <no-reply@captionline.pro>)  [not a secret]
# Verified sender. Must be a sender on a domain you have verified in Resend, or
# delivery will fail or land in spam.
EMAIL_FROM=Captionline <no-reply@captionline.pro>

# EMAIL_TIMEOUT_SECONDS  (default: 10)  [not a secret]
# HTTP timeout for the email provider, in seconds. Bounds how long a forgot-
# password request can wait on a slow provider.
EMAIL_TIMEOUT_SECONDS=10

# ============================================================================
# 9. SUPPORT AND LEGAL TEXT
# ============================================================================
# SUPPORT_EMAIL  (default: unset)  [not a secret]
# The monitored inbox that GET /api/legal/versions reports as
# support_email_configured, and the address the frontend should publish. There
# is no verified inbound mailbox yet, so it is deliberately empty: the legal
# pages say support is not yet available rather than printing an address nobody
# reads. Set it, and set the matching frontend VITE_SUPPORT_EMAIL, before launch.
# SUPPORT_EMAIL=

# ============================================================================
# 10. STRIPE BILLING
# ============================================================================
# All values are supplied by you. Nothing here is invented by the repository and
# no real identifier or key is committed. When STRIPE_SECRET_KEY is absent the
# service still runs: accounts and transcription work, and the pricing page
# reports that checkout is unavailable instead of failing.
#
# STRIPE_SECRET_KEY  (default: unset)  [SECRET]
# Stripe restricted API key. Copy it from Developers -> API keys. Without it,
# checkout reports "not configured".
STRIPE_SECRET_KEY=

# STRIPE_WEBHOOK_SECRET  (default: unset)  [SECRET]
# Signing secret of the endpoint at POST /api/billing/webhook, copied from
# Developers -> Webhooks when the endpoint is created. This is what makes
# Stripe's calls trustworthy, so it is not optional for live billing: without
# it the webhook cannot verify a signature and returns 503. Never accept an
# unverified event, whatever it claims.
STRIPE_WEBHOOK_SECRET=

# STRIPE_PRICE_CREATOR_MONTHLY  (default: unset)  [not a secret]
# Price ID backing the Creator plan ($19/month). Create the Price in the Stripe
# dashboard and copy its price_... ID. The price itself lives in Stripe; this is
# only the pointer to it.
STRIPE_PRICE_CREATOR_MONTHLY=

# STRIPE_PRICE_PRO_MONTHLY  (default: unset)  [not a secret]
# Price ID backing the Pro plan ($39/month).
STRIPE_PRICE_PRO_MONTHLY=

# STRIPE_PRICE_CREATOR_ANNUAL  (default: unset)  [not a secret]
# Price ID backing Creator Annual ($149/year, allowance still resetting
# monthly). Billing cadence and usage cadence are separate: this Price is
# charged once a year while the 500 minutes per month still refresh every month.
STRIPE_PRICE_CREATOR_ANNUAL=

# FRONTEND_URL  (default: http://localhost:5173)  [not a secret]
# Absolute origin of the deployed frontend, no trailing slash. Used for Stripe
# success/cancel redirects and for the reset link in the emailed message. In
# production it must be a real https origin: an http, empty, or localhost value
# is refused at startup when APP_ENV=production, because a reset token would
# then travel in clear text or point nowhere.
FRONTEND_URL=http://localhost:5173

# ============================================================================
# 11. UPLOADS
# ============================================================================
# MAX_UPLOAD_MB  (default: 500)  [not a secret]
# Maximum upload size in megabytes. Files are streamed to a per-request working
# directory and deleted when transcription ends. Note that FastAPI spools the
# multipart body before the request is authorised, so this is a ceiling on disk
# use, not a per-caller quota; the real quota is the metered allowance.
MAX_UPLOAD_MB=500

# TEMP_DIR  (default: unset, i.e. the system temp directory)  [not a secret]
# Explicit working directory for uploads. Leave unset to use the system temp
# dir, which is what ephemeral and container hosts should do. Anything under it
# matching captionline-* is treated as upload scratch space by the sweep below.
# TEMP_DIR=/tmp

# TEMP_SWEEP_MAX_AGE_SECONDS  (default: 86400, i.e. 24 hours)  [not a secret]
# At startup, delete any captionline-* working directory older than this. Each
# request removes its own directory, so anything still present belongs to a
# request that was killed mid-flight (an OOM, a crash, a forced restart) and is
# customer media sitting on disk: a leak, not a cache. This is the upper bound
# on how long a file can survive an abnormal termination, and it is what the
# Privacy Policy tells users. Lower it to shorten that window; the sweep runs
# only at startup, so the bound is "the first start more than this long after
# the request", not "this long after the request".
TEMP_SWEEP_MAX_AGE_SECONDS=86400

# ============================================================================
# 12. MEDIA PROBING AND USAGE HOLDS
# ============================================================================
# FFPROBE_PATH  (default: ffprobe)  [not a secret]
# ffprobe ships with ffmpeg and is used to measure media duration before any
# processing, so the client can never dictate its own length or its own bill.
FFPROBE_PATH=ffprobe

# MAX_MEDIA_DURATION_SECONDS  (default: 0, i.e. no cap)  [not a secret]
# Reject media longer than this many seconds outright. 0 disables the cap. Set a
# real limit in production: transcription is synchronous and one very long
# request holds the global model lock, so it stalls every other request.
MAX_MEDIA_DURATION_SECONDS=0

# USAGE_RESERVATION_TTL_SECONDS  (default: 7200, i.e. 2 hours)  [not a secret]
# A usage hold left behind by a crashed request is released after this long, so a
# crash cannot permanently consume a customer's allowance. This is a backstop:
# holds live in PostgreSQL, not in memory, so a restart does not leak one.
USAGE_RESERVATION_TTL_SECONDS=7200

# ============================================================================
# 13. WHISPERX / MODEL
# ============================================================================
# WHISPERX_MODEL  (default: small)  [not a secret]
# Model size. "small" keeps development downloads and VRAM use reasonable and is
# a reasonable accuracy/speed tradeoff. Use "large-v2" in production for the best
# accuracy. Other options: tiny, base, medium, large-v2, large-v3.
WHISPERX_MODEL=small

# WHISPERX_DEVICE  (default: auto)  [not a secret]
# "auto" uses CUDA when torch reports a usable GPU, otherwise CPU. Set to "cpu"
# to force CPU, which is what a host without a GPU needs. Note that the PyPI
# torch wheel is the CPU build, so "auto" finds no GPU on a machine that has one
# unless the CUDA wheel is installed.
WHISPERX_DEVICE=auto

# WHISPERX_COMPUTE_TYPE  (default: auto)  [not a secret]
# "auto" picks float16 on CUDA and int8 on CPU. Override with e.g. float16,
# int8_float16, float32.
WHISPERX_COMPUTE_TYPE=auto

# WHISPERX_BATCH_SIZE  (default: 8)  [not a secret]
# Batches processed at once during transcription. Lower it if you hit
# out-of-memory errors on a small GPU.
WHISPERX_BATCH_SIZE=8

# WHISPERX_LANGUAGE  (default: unset, i.e. auto-detect)  [not a secret]
# Force a language, e.g. en or sv. Unset means the service detects it.
# WHISPERX_LANGUAGE=

# WHISPERX_ALIGN_MODEL  (default: WAV2VEC2_ASR_BASE_960H)  [not a secret]
# Forced-alignment model used to produce the word-level timestamps the karaoke
# highlighting depends on. It is downloaded on first use (roughly 360 MB).
WHISPERX_ALIGN_MODEL=WAV2VEC2_ASR_BASE_960H

# WHISPERX_ALIGN_ENABLED  (default: 1 / true)  [not a secret]
# Set to 0/false to skip alignment. That makes transcription much faster but
# produces no word timings, which disables karaoke highlighting, so leave it on
# unless you have measured a need for the speed.
WHISPERX_ALIGN_ENABLED=1

# ============================================================================
# 14. DIAGNOSTICS
# ============================================================================
# PRELOAD_MODEL  (default: 0 / false)  [not a secret]
# Set to 1 to load WhisperX at startup instead of on the first request. Useful
# when the platform has a tight startup timeout and a generous request timeout:
# otherwise the first request after a cold start pays the whole model-load cost.
PRELOAD_MODEL=0
