# Captionline transcription service - environment configuration.
#
# Copy to `.env` for local development:
#   cp .env.example .env
#
# NEVER commit a real .env file. No secrets are required for transcription: the
# WhisperX models are public. The only secret in the system is DATABASE_URL,
# which is supplied by the platform in production.

# --- Database (Phase 3A) ---------------------------------------------------
# Required for accounts. Leave unset to run transcription-only: the service
# still starts and transcribes, /api/health reports
# database.status = "not_configured", and the account endpoints return 503.
#
# Production (Railway): set DATABASE_URL to the Postgres service reference:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# `postgres://` and `postgresql://` are both accepted and normalised to
# postgresql+psycopg:// automatically.
#
# Local development with a real PostgreSQL (replace the password placeholder):
#   DATABASE_URL=postgresql://captionline:<your-local-password>@localhost:5432/captionline
#
# Local development without PostgreSQL (schema is portable, so this works for
# development and the test suite, but NOT for production):
#   DATABASE_URL=sqlite:///./captionline.db
DATABASE_URL=

# Log every SQL statement. Never enable in production: statements can contain
# values derived from user input.
DATABASE_ECHO=0

# --- WhisperX / model ------------------------------------------------------
# Model size. "small" keeps development light. Use "large-v2" in production for
# the best accuracy. Other options: tiny, base, medium, large-v2, large-v3.
WHISPERX_MODEL=small

# "auto" uses CUDA when torch reports a usable GPU, otherwise CPU.
# Set to "cpu" to force CPU (required on hosts without a GPU).
WHISPERX_DEVICE=auto

# "auto" picks float16 on CUDA and int8 on CPU.
# Override with e.g. float16, int8_float16, float32.
WHISPERX_COMPUTE_TYPE=auto

# Batches processed at once during transcription. Lower it if you hit
# out-of-memory errors on a small GPU.
WHISPERX_BATCH_SIZE=8

# Force a language (e.g. en, sv). Leave unset to auto-detect.
# WHISPERX_LANGUAGE=

# Forced-alignment model used to produce word-level timestamps.
WHISPERX_ALIGN_MODEL=WAV2VEC2_ASR_BASE_960H

# Set to 0/false to skip alignment. This makes transcription much faster but
# produces no word timestamps, which disables karaoke highlighting.
WHISPERX_ALIGN_ENABLED=1

# --- Server ----------------------------------------------------------------
# Railway supplies PORT. 8000 is the local default.
PORT=8000
HOST=0.0.0.0

# Comma-separated allowed origins.
# Local defaults allow the Vite dev server and preview server.
# In production, set this to the deployed Captionline frontend origin, e.g.
#   CORS_ORIGINS=https://captionline.up.railway.app
# Use "*" only for initial testing.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# --- Accounts --------------------------------------------------------------
# Lifetime of an issued bearer session, in days.
SESSION_TTL_DAYS=30

# Minimum accepted password length at registration.
MIN_PASSWORD_LENGTH=8

# How often expired/revoked session rows are purged opportunistically.
SESSION_CLEANUP_INTERVAL_SECONDS=900

# --- Stripe (Phase 3B) ---------------------------------------------------
# All values are supplied by you. Nothing here is invented by the repository and
# no real identifier is committed. When STRIPE_SECRET_KEY is absent the service
# still runs: accounts and transcription work, and the pricing page reports that
# checkout is unavailable instead of failing.
#
# Required for live billing:
#   STRIPE_SECRET_KEY=sk_live_...
#   STRIPE_WEBHOOK_SECRET=whsec_...
#
# Price IDs, created by you in the Stripe dashboard (or via the Stripe API):
STRIPE_PRICE_CREATOR_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_CREATOR_ANNUAL=

# Absolute origin of the deployed frontend. Used for Stripe success/cancel
# redirects and must be the real custom domain, not a placeholder.
# Set this to your own domain once you attach it in Railway.
FRONTEND_URL=http://localhost:5173

# --- Transactional email ----------------------------------------------------
# Password reset emails only. No other transactional mail exists yet.
#
# EMAIL_PROVIDER=resend   production (requires EMAIL_API_KEY)
# EMAIL_PROVIDER=console  local development only; writes the email to the log
# EMAIL_PROVIDER=memory   tests only
# (unset or anything else) no provider: password reset still answers with the
#                         generic response, but no email is delivered.
#
# "console" and "memory" never activate unless named explicitly, so a production
# deployment cannot print reset links to the log stream.
EMAIL_PROVIDER=none

# Resend API key. Server side only; the frontend never sees it.
# Obtain from the Resend dashboard -> API Keys.
EMAIL_API_KEY=

# Verified sender. Must be a domain you have verified in Resend.
# Obtain by adding and verifying the sending domain in Resend.
EMAIL_FROM=Captionline <no-reply@captionline.pro>

# HTTP timeout for the email provider, in seconds.
EMAIL_TIMEOUT_SECONDS=10

# --- Password reset ---------------------------------------------------------
# How long a reset link stays usable. 60 minutes is a reasonable window.
PASSWORD_RESET_TTL_MINUTES=60

# Per-account abuse control: a new request within this window of the last one is
# ignored (the generic response is still returned).
PASSWORD_RESET_COOLDOWN_SECONDS=60

# Oldest outstanding tokens for an account are revoked once this many exist.
PASSWORD_RESET_MAX_ACTIVE=3

# Per-client-address throttle, applied before any database work. In-process and
# therefore best effort: it resets on restart and is per replica. It stores no
# personal data.
PASSWORD_RESET_IP_LIMIT=5
PASSWORD_RESET_IP_WINDOW_SECONDS=900

# --- Media probing ---------------------------------------------------------
# ffprobe ships with ffmpeg. Used to measure real duration before billing, so
# the client can never declare its own length.
FFPROBE_PATH=ffprobe

# Reject media longer than this many seconds. 0 disables the cap.
MAX_MEDIA_DURATION_SECONDS=0

# A usage hold left behind by a crashed request is released after this long, so
# a crash cannot permanently consume a customer's allowance.
USAGE_RESERVATION_TTL_SECONDS=7200

# --- Uploads ---------------------------------------------------------------
# Maximum upload size in megabytes. Files are written to a temporary directory
# and deleted immediately after transcription.
MAX_UPLOAD_MB=500

# Optional explicit temp directory. Leave unset to use the system temp dir,
# which is what ephemeral/container hosts should do.
# TEMP_DIR=/tmp

# --- Diagnostics -----------------------------------------------------------
# Set to 1 to load the model at startup instead of on the first request.
# Useful when the platform needs a generous startup timeout.
PRELOAD_MODEL=0
