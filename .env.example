# Captionline environment variables
#
# Phase 1 runs entirely in the browser and requires NO environment variables.
# The video never leaves the device, and captions come from sample data.
#
# The placeholders below are reserved for later phases (backend API,
# transcription, authentication, billing, storage). They are intentionally
# commented out so `npm run dev` and `npm run build` work with no setup.
#
# Copy this file to `.env.local` when you need real values:
#   cp .env.example .env.local

# --- Backend API (future phase) ---
# VITE_API_BASE_URL=https://api.captionline.app

# --- Transcription service (future phase) ---
# VITE_TRANSCRIPTION_PROVIDER=
# VITE_TRANSCRIPTION_API_KEY=

# --- Authentication (future phase) ---
# VITE_AUTH_PROVIDER=
# VITE_AUTH_CLIENT_ID=

# --- Database / storage (future phase) ---
# VITE_DATABASE_URL=
# VITE_STORAGE_BUCKET=

# --- Billing (future phase) ---
# VITE_BILLING_PROVIDER=
# VITE_BILLING_PUBLISHABLE_KEY=
